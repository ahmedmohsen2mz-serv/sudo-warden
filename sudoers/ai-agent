    /usr/bin/redis-cli dbsize, \
    /usr/bin/redis-cli slowlog get *, \
    /usr/bin/redis-cli client list, \
    /usr/bin/redis-cli config get *, \
    /usr/bin/mongosh --eval *

# --- Cron (read-only) ---
Cmnd_Alias AI_CRON = \
    /usr/bin/crontab -l, \
    /usr/bin/crontab -l -u *

# --- Performance & Tracing ---
Cmnd_Alias AI_PERF = \
    /usr/bin/strace, \
    /usr/bin/ltrace, \
    /usr/sbin/tcpdump, \
    /usr/bin/perf stat *, \
    /usr/bin/perf top, \
    /usr/bin/iotop, \
    /usr/bin/iftop, \
    /usr/bin/iostat, \
    /usr/bin/sar, \
    /usr/bin/nmon, \
    /usr/bin/dstat

# --- Package Query (read-only) ---
Cmnd_Alias AI_PKG_QUERY = \
    /usr/bin/dpkg -l, \
    /usr/bin/dpkg -l *, \
    /usr/bin/dpkg -L *, \
    /usr/bin/dpkg -s *, \
    /usr/bin/dpkg --print-architecture, \
    /usr/bin/apt list, \
    /usr/bin/apt list *, \
    /usr/bin/apt show *, \
    /usr/bin/apt-cache *, \
    /usr/bin/rpm -qa, \
    /usr/bin/rpm -qi *, \
    /usr/bin/rpm -ql *, \
    /usr/bin/yum list *, \
    /usr/bin/dnf list *, \
    /usr/bin/snap list

# --- Security Audit (read-only) ---
Cmnd_Alias AI_SECURITY = \
    /usr/bin/fail2ban-client status, \
    /usr/bin/fail2ban-client status *, \
    /usr/bin/getfacl, \
    /usr/bin/getfacl *, \
    /usr/bin/getfattr, \
    /usr/bin/getfattr *, \
    /usr/sbin/aa-status, \
    /usr/sbin/getenforce, \
    /usr/sbin/sestatus, \
    /usr/bin/chage -l *, \
    /usr/bin/passwd -S *

# ================================================================
#  WRITE OPERATION ALIASES (Controlled via wrapper scripts)
#  These wrappers enforce: logging, backup, and audit trail
# ================================================================

Cmnd_Alias AI_WRITE_FILE = /usr/local/bin/ai-safe-edit *
Cmnd_Alias AI_WRITE_PKG  = /usr/local/bin/ai-safe-pkg *
Cmnd_Alias AI_WRITE_SVC  = /usr/local/bin/ai-safe-svc *

# ================================================================
#  PERMISSION ASSIGNMENTS
# ================================================================

# Read-Only Diagnostics - No password, full diagnostic freedom
ai-agent ALL=(ALL) NOPASSWD: AI_SYSINFO
ai-agent ALL=(ALL) NOPASSWD: AI_PROCESS
ai-agent ALL=(ALL) NOPASSWD: AI_STORAGE
ai-agent ALL=(ALL) NOPASSWD: AI_NETWORK
ai-agent ALL=(ALL) NOPASSWD: AI_FIREWALL
ai-agent ALL=(ALL) NOPASSWD: AI_LOGS
ai-agent ALL=(ALL) NOPASSWD: AI_FILEREAD
ai-agent ALL=(ALL) NOPASSWD: AI_SERVICE_RO
ai-agent ALL=(ALL) NOPASSWD: AI_DOCKER_RO
ai-agent ALL=(ALL) NOPASSWD: AI_SSL
ai-agent ALL=(ALL) NOPASSWD: AI_WEBSERVER
ai-agent ALL=(ALL) NOPASSWD: AI_DATABASE
ai-agent ALL=(ALL) NOPASSWD: AI_CRON
ai-agent ALL=(ALL) NOPASSWD: AI_PERF
ai-agent ALL=(ALL) NOPASSWD: AI_PKG_QUERY
ai-agent ALL=(ALL) NOPASSWD: AI_SECURITY

# Interactive readers & find - NOEXEC prevents shell escape
ai-agent ALL=(ALL) NOEXEC:NOPASSWD: AI_FILEREAD_INTERACTIVE
ai-agent ALL=(ALL) NOEXEC:NOPASSWD: AI_FIND

# Write Operations - No password but ONLY through audited wrappers
# The wrappers enforce backup + logging before any change
ai-agent ALL=(ALL) NOPASSWD: AI_WRITE_FILE
ai-agent ALL=(ALL) NOPASSWD: AI_WRITE_PKG
ai-agent ALL=(ALL) NOPASSWD: AI_WRITE_SVC

# ================================================================
#  END OF AI AGENT SUDOERS - DO NOT ADD RULES BELOW THIS LINE
# ================================================================
