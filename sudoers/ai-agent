# ============================================================
# AI AGENT SUDOERS CONFIGURATION - PRODUCTION SERVER
# File: /etc/sudoers.d/ai-agent
# Deploy: cp ai-agent /etc/sudoers.d/ && chmod 0440 /etc/sudoers.d/ai-agent
# Validate: visudo -cf /etc/sudoers.d/ai-agent
# ============================================================
# Security Model: WHITELIST ONLY - only listed commands are allowed
# Read-Only Diagnostics: NOPASSWD (free diagnostic access)
# Write Operations: Through audited wrapper scripts ONLY
# All I/O: Logged to /var/log/ai-agent/
# ============================================================

# ----------------------------------------------------------------
# DEFAULTS - Strict security & full audit trail
# ----------------------------------------------------------------
Defaults:ai-agent    timestamp_timeout=0
Defaults:ai-agent    passwd_timeout=0
Defaults:ai-agent    log_input, log_output
Defaults:ai-agent    iolog_dir=/var/log/ai-agent/sudo-io/%{seq}
Defaults:ai-agent    logfile=/var/log/ai-agent/sudo.log
Defaults:ai-agent    env_reset
Defaults:ai-agent    secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Defaults:ai-agent    !requiretty
Defaults:ai-agent    use_pty
Defaults:ai-agent    umask=0022

# ================================================================
#  READ-ONLY COMMAND ALIASES (Diagnostic - No Approval Needed)
# ================================================================

# --- System Information & Hardware ---
Cmnd_Alias AI_SYSINFO = \
    /usr/bin/uptime, \
    /usr/bin/uname, \
    /usr/bin/hostname, \
    /usr/bin/hostnamectl, \
    /usr/bin/timedatectl, \
    /usr/bin/whoami, \
    /usr/bin/id, \
    /usr/bin/w, \
    /usr/bin/who, \
    /usr/bin/last, \
    /usr/bin/lastlog, \
    /usr/bin/lastb, \
    /usr/bin/lscpu, \
    /usr/bin/lsmem, \
    /usr/bin/lspci, \
    /usr/bin/lsusb, \
    /usr/bin/nproc, \
    /usr/bin/arch, \
    /usr/bin/getconf *, \
    /usr/bin/dmidecode, \
    /usr/sbin/dmidecode

# --- Process, CPU & Memory Monitoring ---
Cmnd_Alias AI_PROCESS = \
    /usr/bin/ps, \
    /usr/bin/top, \
    /usr/bin/htop, \
    /usr/bin/atop, \
    /usr/bin/free, \
    /usr/bin/vmstat, \
    /usr/bin/mpstat, \
    /usr/bin/pidof, \
    /usr/bin/pgrep, \
    /usr/bin/pmap, \
    /usr/bin/lsof, \
    /usr/sbin/slabtop, \
    /usr/bin/ipcs, \
    /usr/bin/ipcrm

# --- Disk, Filesystem & Storage ---
Cmnd_Alias AI_STORAGE = \
    /usr/bin/df, \
    /usr/bin/du, \
    /usr/bin/mount, \
    /usr/bin/lsblk, \
    /usr/sbin/blkid, \
    /usr/sbin/fdisk -l, \
    /usr/sbin/fdisk -l *, \
    /usr/sbin/parted -l, \
    /usr/sbin/parted print, \
    /usr/sbin/lvs, \
    /usr/sbin/vgs, \
    /usr/sbin/pvs, \
    /usr/sbin/lvdisplay, \
    /usr/sbin/vgdisplay, \
    /usr/sbin/pvdisplay, \
    /usr/bin/findmnt, \
    /usr/sbin/tune2fs -l *, \
    /usr/sbin/xfs_info *, \
    /usr/sbin/smartctl, \
    /usr/sbin/mdadm --detail *

# --- Network Diagnostics ---
Cmnd_Alias AI_NETWORK = \
    /usr/bin/ss, \
    /usr/bin/netstat, \
    /usr/sbin/ip, \
    /usr/sbin/ifconfig, \
    /usr/bin/ping, \
    /usr/bin/ping6, \
    /usr/bin/traceroute, \
    /usr/bin/traceroute6, \
    /usr/bin/mtr, \
    /usr/bin/dig, \
    /usr/bin/nslookup, \
    /usr/bin/host, \
    /usr/sbin/ethtool, \
    /usr/sbin/arp, \
    /usr/bin/arping, \
    /usr/bin/nmap

# --- Firewall (read-only listing ONLY) ---
Cmnd_Alias AI_FIREWALL = \
    /usr/sbin/iptables -L, \
    /usr/sbin/iptables -L *, \
    /usr/sbin/iptables -S, \
    /usr/sbin/iptables -S *, \
    /usr/sbin/iptables -t * -L, \
    /usr/sbin/iptables -t * -L *, \
    /usr/sbin/iptables -t * -S, \
    /usr/sbin/iptables -t * -S *, \
    /usr/sbin/iptables-save, \
    /usr/sbin/ip6tables -L, \
    /usr/sbin/ip6tables -L *, \
    /usr/sbin/ip6tables -S, \
    /usr/sbin/ip6tables -S *, \
    /usr/sbin/ip6tables-save, \
    /usr/sbin/nft list *, \
    /usr/sbin/ufw status, \
    /usr/sbin/ufw status *

# --- System Logs ---
Cmnd_Alias AI_LOGS = \
    /usr/bin/journalctl, \
    /usr/bin/dmesg, \
    /usr/bin/ausearch, \
    /usr/sbin/aureport

# --- Safe File Reading (truly read-only commands) ---
Cmnd_Alias AI_FILEREAD = \
    /usr/bin/cat, \
    /usr/bin/head, \
    /usr/bin/tail, \
    /usr/bin/grep, \
    /usr/bin/egrep, \
    /usr/bin/fgrep, \
    /usr/bin/which, \
    /usr/bin/whereis, \
    /usr/bin/file, \
    /usr/bin/stat, \
    /usr/bin/ls, \
    /usr/bin/tree, \
    /usr/bin/wc, \
    /usr/bin/sort, \
    /usr/bin/uniq, \
    /usr/bin/diff, \
    /usr/bin/comm, \
    /usr/bin/md5sum, \
    /usr/bin/sha256sum, \
    /usr/bin/sha1sum, \
    /usr/bin/base64, \
    /usr/bin/xxd, \
    /usr/bin/strings, \
    /usr/bin/od, \
    /usr/bin/zcat, \
    /usr/bin/zgrep, \
    /usr/bin/bzcat, \
    /usr/bin/xzcat, \
    /usr/bin/jq

# --- Interactive File Readers (NOEXEC to block shell escapes) ---
Cmnd_Alias AI_FILEREAD_INTERACTIVE = \
    /usr/bin/less, \
    /usr/bin/more

# --- Find/Locate (NOEXEC to prevent -exec abuse) ---
Cmnd_Alias AI_FIND = \
    /usr/bin/find, \
    /usr/bin/locate

