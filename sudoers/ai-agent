# --- Web Server Config Validation (read-only) ---
Cmnd_Alias AI_WEBSERVER = \
    /usr/sbin/nginx -t, \
    /usr/sbin/nginx -T, \
    /usr/sbin/nginx -V, \
    /usr/sbin/apache2ctl -t, \
    /usr/sbin/apache2ctl -S, \
    /usr/sbin/apache2ctl -M, \
    /usr/sbin/apachectl -t, \
    /usr/sbin/apachectl -S, \
    /usr/sbin/apachectl -M

# --- Database Status (read-only) ---
Cmnd_Alias AI_DATABASE = \
    /usr/bin/mysqladmin status, \
    /usr/bin/mysqladmin processlist, \
    /usr/bin/mysqladmin extended-status, \
    /usr/bin/mysqladmin variables, \
    /usr/bin/mysqladmin ping, \
    /usr/bin/pg_isready, \
